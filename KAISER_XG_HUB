-- Brookhaven RP Auto Name & Bio Script (Updated)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local rpNameText = "Oc3 v3 ultra spammer\nTHE eternity| Oc3 v3 ULTRA SPAM LORD C"
local rpBioText = "@@@@@@@@@@@@===================\n\\================={ Oc3aN H8RS\n🗼 pe :D }🔥"

local function applyProfile()
    -- 1. Fire Brookhaven's primary server remotes
    pcall(function()
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local n = obj.Name:lower()
                if n == "bcevent" or n == "re" or n:find("roleplay") or n:find("rp") then
                    obj:FireServer("RolePlayName", rpNameText)
                    obj:FireServer("RolePlayBio", rpBioText)
                    obj:FireServer("RPName", rpNameText)
                    obj:FireServer("RPBio", rpBioText)
                end
            end
        end
    end)

    -- 2. Direct client UI injection (forces text into the input boxes)
    pcall(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 3)
        if playerGui then
            for _, v in pairs(playerGui:GetDescendants()) do
                if v:IsA("TextBox") then
                    if v.Name:lower():find("name") then
                        v.Text = rpNameText
                    elseif v.Name:lower():find("bio") or v.Name:lower():find("info") then
                        v.Text = rpBioText
                    end
                end
            end
        end
    end)
end

-- Execute twice to handle initial menu loads
applyProfile()
task.wait(1)
applyProfile()
