local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- 1. Execute Instant Notifications & Brookhaven Name/Bio Update
local function onExecution()
    -- Chat Activation Message
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync("KAISER_V1 Script Activated!")
            end
        else
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("KAISER_V1 Script Activated!", "All")
        end
    end)

    -- Brookhaven Roleplay Name & Bio Update
    pcall(function()
        local RPEvent = ReplicatedStorage:FindFirstChild("RE", true) or ReplicatedStorage:FindFirstChild("RPEvent", true)
        if RPEvent then
            -- Update Name to KAISER_V2
            RPEvent:FireServer("RPName", "KAISER_V2")
            -- Update Bio to welcome message
            RPEvent:FireServer("RPBio", "welcome " .. LocalPlayer.Name .. " To Kaiser hub.")
        end
    end)
end

onExecution()

