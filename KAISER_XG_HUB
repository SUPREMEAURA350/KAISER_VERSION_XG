local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local window = Rayfield:CreateWindow({
    name = "Example Hub",
    subtitle = "Rayfield Gen2",
})

local tab = window:CreateTab({ name = "Home", icon = 93364949241311 })

tab:CreateButton({
    name = "Say hello",
    callback = function()
        window:Notify({ title = "Hello", content = "Your first element works." })
    end,
})

tab:CreateToggle({
    name = "Auto Sprint",
    callback = function(value)
        print("Auto Sprint:", value)
    end,
})

-- 1. Auto-Execution Actions (Instant Chat Notification & Brookhaven RP Name/Bio Update)
local function onExecution()
    -- Send Instant Chat Message
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync("@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ 🔱⚔️KAISER_V3 SPAMMER LOADED⚔️🔱")
            end
        else
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer("@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ 🔱⚔️KAISER_V3 SPAMMER LOADED⚔️🔱", "All")
        end
    end)

    -- Update Brookhaven RP Name and Bio
    pcall(function()
        local RPEvent = ReplicatedStorage:FindFirstChild("RE") and ReplicatedStorage.RE:FindFirstChild("1RPName1") 
                     or ReplicatedStorage:FindFirstChild("RE", true)
        
        if RPEvent then
            -- Pass the custom name and bio through Brookhaven's network event format
            RPEvent:FireServer("RPName", "KAISER_V2")
            RPEvent:FireServer("RPBio", "welcome " .. LocalPlayer.Name .. " To Kaiser hub.")
        end
    end)
end
