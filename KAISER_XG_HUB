-- Brookhaven RP Working Auto Name & Bio Script
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Exact Text Formatting
local rpNameText = "Oc3 v3 ultra spammer\nTHE eternity| Oc3 v3 ULTRA SPAM LORD C"
local rpBioText = "@@@@@@@@@@@@===================\n\\================={ Oc3aN H8RS\n🗼 pe :D }🔥"

local function applyProfile()
    -- Look for standard Brookhaven RE Event Folder
    local RE = ReplicatedStorage:FindFirstChild("RE") or ReplicatedStorage:FindFirstChild("RemoteEvents")
    
    if RE then
        -- Method 1: Firing via main RE Client Trigger
        for _, remote in pairs(RE:GetChildren()) do
            if remote:IsA("RemoteEvent") then
                pcall(function()
                    remote:FireServer("RPName", rpNameText)
                    remote:FireServer("RPBio", rpBioText)
                    remote:FireServer("SetRPName", rpNameText)
                    remote:FireServer("SetRPBio", rpBioText)
                end)
            end
        end
    end

    -- Method 2: Direct UI / Character Customization Hook Fallback
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            -- Set text inside client UI textboxes if visible
            for _, v in pairs(playerGui:GetDescendants()) do
                if v:IsA("TextBox") then
                    if v.Name:lower():find("name") then
                        v.Text = rpNameText
                    elseif v.Name:lower():find("bio") or v.Name:lower():find("info") then
                        v.Text = rpBioText
                    end
                end
            end
        end
    end)
end

-- Run function twice to ensure load registration
applyProfile()
task.wait(0.5)
applyProfile()


